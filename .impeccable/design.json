    {
      "name": "Signband (옐로 안내 밴드)",
      "kind": "custom",
      "refersTo": "signband",
      "description": "시그니처 웨이파인딩 표면 — 목표·안내 전용, 링크 시 모서리 고정 화살표.",
      "html": "<a class=\"ds-signband\" href=\"#\"><span class=\"ds-picto\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18zm0 3.2a5.8 5.8 0 1 0 0 11.6 5.8 5.8 0 0 0 0-11.6zm0 3.3a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z\"/></svg></span><span><span class=\"ds-signband-title\">체지방 20.3 → 18.5kg</span><span class=\"ds-signband-sub\">2026-08-10 · 진행 42%</span></span><span class=\"ds-signband-arrow\"><svg viewBox=\"0 0 24 24\"><path d=\"M13.2 4.2 20 11v2l-6.8 6.8-2.1-2.1 3.9-3.9H4v-3.6h11l-3.9-3.9z\"/></svg></span></a>",
      "css": ".ds-signband{background:#FFC900;color:#0E0E0D;border-radius:10px;padding:18px 20px;display:flex;align-items:center;gap:16px;text-decoration:none;font-family:'Pretendard Variable',Pretendard,sans-serif}.ds-signband:hover{background:#E9B800}.ds-signband:hover .ds-signband-arrow{transform:translateX(4px)}.ds-picto{width:38px;height:38px;border-radius:7px;background:#0E0E0D;color:#FFC900;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}.ds-picto svg{width:22px;height:22px;fill:currentColor}.ds-signband-title{display:block;font-weight:800;font-size:1.02rem}.ds-signband-sub{display:block;color:#665000;font-size:.85rem;font-weight:600;margin-top:2px}.ds-signband-arrow{margin-left:auto;flex-shrink:0;transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-signband-arrow svg{width:34px;height:34px;fill:currentColor}"
    },
    {
      "name": "Black Data Board",
      "kind": "card",
      "refersTo": "board",
      "description": "제트블랙 숫자 전광판 — 라벨 위, 값 아래, 핵심 셀은 gate 스케일 + 옐로.",
      "html": "<div class=\"ds-board\"><div class=\"ds-board-row\"><div class=\"ds-cell\"><div class=\"ds-label\">오늘 섭취</div><div class=\"ds-val\">1240<span class=\"ds-unit\">kcal</span></div></div><div class=\"ds-cell\"><div class=\"ds-label\">남은 허용</div><div class=\"ds-gate\">360<span class=\"ds-unit\">kcal</span></div></div></div></div>",
      "css": ".ds-board{background:#0E0E0D;color:#fff;border-radius:10px;overflow:hidden;font-family:'Pretendard Variable',Pretendard,sans-serif;font-feature-settings:'tnum'}.ds-board-row{display:grid;grid-auto-flow:column;grid-auto-columns:1fr}.ds-cell{padding:16px 18px;border-left:1px solid #3A3A37}.ds-cell:first-child{border-left:none}.ds-label{font-size:.78rem;font-weight:600;color:#B8B8B0;margin-bottom:2px}.ds-val{font-size:1.5rem;font-weight:800;letter-spacing:-.01em;line-height:1.2}.ds-gate{font-size:clamp(2.2rem,6vw,4.6rem);font-weight:800;letter-spacing:-.02em;line-height:1.05;color:#FFC900}.ds-unit{font-size:.7rem;font-weight:600;color:#B8B8B0;margin-left:2px}"
    },
    {
      "name": "White Sheet + Inset",
      "kind": "card",
      "refersTo": "sheet",
