      "html": "<div class=\"ds-sheet\"><div class=\"ds-sheet-title\">매크로 목표</div><div class=\"ds-inset\"><div class=\"ds-inset-label\">단백질 40%</div><div class=\"ds-inset-val\">98 / 145<span class=\"ds-inset-unit\">g</span></div><div class=\"ds-track\"><div class=\"ds-fill\" style=\"width:68%\"></div></div></div></div>",
      "css": ".ds-sheet{background:#FFFFFF;border:1px solid #D9D9D2;border-radius:10px;padding:20px;font-family:'Pretendard Variable',Pretendard,sans-serif;font-feature-settings:'tnum';color:#151513}.ds-sheet-title{font-weight:800;margin-bottom:10px}.ds-inset{background:#F4F4F0;border-radius:7px;padding:12px 14px}.ds-inset-label{font-size:.78rem;font-weight:600;color:#5D5D57}.ds-inset-val{font-size:1.2rem;font-weight:800}.ds-inset-unit{font-size:.7rem;font-weight:600;color:#5D5D57;margin-left:2px}.ds-track{background:#E4E4DE;border-radius:4px;height:8px;overflow:hidden;margin-top:6px}.ds-fill{height:100%;background:#0E0E0D}"
    },
    {
