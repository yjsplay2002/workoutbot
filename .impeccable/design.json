      "html": "<table class=\"ds-rows\"><thead><tr><th class=\"ds-l\">날짜</th><th>섭취</th><th>당일 적자</th></tr></thead><tbody><tr><td class=\"ds-l\">08-04</td><td>1580</td><td class=\"ds-ok\">712</td></tr><tr><td class=\"ds-l\">08-03</td><td>2140</td><td class=\"ds-bad\">-96</td></tr></tbody></table>",
      "css": ".ds-rows{width:100%;border-collapse:collapse;font-size:.86rem;font-family:'Pretendard Variable',Pretendard,sans-serif;font-feature-settings:'tnum';color:#151513}.ds-rows th{font-weight:600;color:#5D5D57;padding:7px 9px;text-align:right}.ds-rows td{padding:7px 9px;border-top:1px solid #D9D9D2;text-align:right}.ds-rows .ds-l{text-align:left}.ds-rows .ds-ok{font-weight:700;color:#0E7A3C}.ds-rows .ds-bad{font-weight:700;color:#C42B1C}"
    }
