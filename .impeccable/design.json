      "css": ".ds-nav{background:#0E0E0D;color:#fff;padding:0 20px;display:flex;align-items:stretch;gap:2px;min-height:56px;font-family:'Pretendard Variable',Pretendard,sans-serif}.ds-logo{display:flex;align-items:center;gap:10px;font-size:1.05rem;font-weight:800;letter-spacing:-.01em;color:#fff;margin-right:18px;text-decoration:none}.ds-mark{width:32px;height:32px;border-radius:6px;background:#FFC900;color:#0E0E0D;display:inline-flex;align-items:center;justify-content:center}.ds-mark svg{width:20px;height:20px;fill:currentColor}.ds-navlink{display:flex;align-items:center;padding:0 14px;color:#B8B8B0;font-size:.95rem;font-weight:600;text-decoration:none}.ds-navlink:hover{color:#fff}.ds-navlink.ds-active{background:#FFC900;color:#0E0E0D;font-weight:800}"
    },
